{
  "manifest_version": 3,
  "name": "Internet Downloader Linux",
  "short_name": "ID Linux",
  "version": "1.0.4",
  "description": "Capture downloads and send links, audio, and video to Internet Downloader Linux.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ID Linux",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "tabs",
    "nativeMessaging",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
